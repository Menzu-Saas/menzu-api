# API (Render). Copie para .env.local. Nunca versione valores reais.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Endereço público do FRONT. No computador: http://localhost:3003
NEXT_PUBLIC_APP_URL=
SUPABASE_SERVICE_ROLE_KEY=
MENZU_SESSION_SECRET=
MENZU_ORDER_API_KEY=

# Fila de pedidos. Segredo com 32 caracteres ou mais.
MENZU_QUEUE_URL=http://127.0.0.1:3103
MENZU_QUEUE_SECRET=
MENZU_QUEUE_DB=.local/order-queue.sqlite
MENZU_QUEUE_WORKER_URL=http://127.0.0.1:3004
MENZU_QUEUE_CAPACITY=250
MENZU_QUEUE_RATE=5
MENZU_QUEUE_CONCURRENCY=4

# 64 caracteres hexadecimais; as MESMAS do front. Guarde um backup seguro.
MENZU_CPF_ENCRYPTION_KEY=
ASAAS_ENCRYPTION_KEY=
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=
ASAAS_PLATFORM_WALLET_ID=
ASAAS_WEBHOOK_TOKEN=
ASAAS_RECONCILE_SECRET=
ASAAS_SWEEP_URL=http://127.0.0.1:3004
ASAAS_SWEEP_SECONDS=60

# Vazio: só pagamento presencial. "asaas": Pix e cartão. Igual no front.
MENZU_ONLINE_PROVIDER=
MENZU_GEOCODING_ENABLED=true

# Opcional.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_DEFAULT_PAYER_EMAIL=
